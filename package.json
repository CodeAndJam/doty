{
  "name": "doty",
  "version": "3.2.0",
  "description": "Continuous STT + AI music recommender",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "rebuild": "electron-rebuild --only better-sqlite3",
    "copy-wasm": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm','public/ort-wasm-simd-threaded.wasm')\"",
    "postinstall": "pnpm run rebuild && pnpm run copy-wasm",
    "dist": "pnpm run build && electron-builder --mac dmg",
    "pack": "electron-builder --mac dmg",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "stt:eval": "STT_QUALITY=1 vitest run electron/stt-quality.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.codeandjam.doty",
    "productName": "Doty",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/essentia.js/dist/**",
      "node_modules/better-sqlite3/**",
      "node_modules/@discordjs/opus/**",
      "node_modules/sodium-native/**",
      "node_modules/opusscript/**",
      "node_modules/prism-media/**",
      "node_modules/@transcribe-cpp/**",
      "node_modules/koffi/**",
      "node_modules/transcribe-cpp/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/@transcribe-cpp/darwin-arm64-metal",
        "to": "transcribe-cpp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Doty needs microphone access to transcribe your tabletop RPG sessions and recommend matching music in real time."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Doty ${version}"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "4.3.2",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "discord.js": "^14.28.1",
    "essentia.js": "^0.1.3",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.3.4",
    "node-llama-cpp": "^3.22.2",
    "onnxruntime-node": "^1.31.1",
    "opusscript": "0.1.1",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.2.0",
    "sqlite-vec": "^0.1.9",
    "transcribe-cpp": "^0.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --no-errors-on-unmatched"
    ],
    "*.{json,css,md}": [
      "biome format --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
